# Dependencies
node_modules/

# Build outputs (esbuild plugin bundle + webpack federation panel)
dist/
public/
*.tsbuildinfo

# Coverage (Vitest v8 default output)
coverage/

# Tool caches
.cache/

# Editor / IDE state
.vscode/
.idea/
*.swp
*.swo
*~

# OS noise
.DS_Store
Thumbs.db

# Logs (covers npm-debug.log, yarn-error.log, vite.log, etc.)
*.log

# Merge conflict artifacts
*.orig
*.rej

# Environment files
.env
.env.*
!.env.example

# Secrets, credentials, keys, certs (defensive; never commit these)
.npmrc
secrets/
secrets.json
credentials.json
*.secret
*.secrets
*.credentials
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# Local agent / session state
.claude/
.cave/
.remember/

# Temporary scratch
temp/
tmp/

# Signal K dev install layout (we are usually symlinked from ~/.signalk)
.signalk/

# npm pack tarball
*.tgz

# Superpowers brainstorming companion
.superpowers/
