{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
	"files": {
		"includes": ["src/**/*.ts", "src/**/*.tsx", "*.json", "webpack.config.cjs"],
		"ignoreUnknown": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "warn",
				"noConsole": {
					"level": "warn",
					"options": { "allow": ["error", "warn"] }
				}
			},
			"style": {
				"useConst": "error",
				"useImportType": "error"
			}
		}
	}
}
