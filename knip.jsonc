{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": ["src/panel/PluginConfigurationPanel.tsx"],
	"includeEntryExports": true,
	// scripts/link-signalk-admin.mjs resolves these from the Signal K test host
	// the signalk-admin CI job installs, not from this package's own tree.
	"ignoreDependencies": ["signalk-server", "@signalk/server-admin-ui"],
	// The same CI job starts that host's own signalk-server binary from its
	// directory, so the binary is never installed in this package either.
	"ignoreBinaries": ["signalk-server"],
	"treatConfigHintsAsErrors": true,
	"cycles": {
		"dynamicImports": true
	},
	"rules": {
		"cycles": "error"
	}
}
