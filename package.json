{
	"name": "signalk-nmea2000-emitter-cannon",
	"version": "1.9.0",
	"description": "Signal K plugin that converts Signal K deltas to Garmin-aligned NMEA 2000 PGNs",
	"main": "dist/index.mjs",
	"files": [
		"dist/",
		"public/",
		"assets/",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "npm run clean && npm run build:plugin && npm run build:panel",
		"build:plugin": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.mjs --external:rxjs",
		"build:panel": "webpack --config webpack.config.cjs",
		"build:watch": "npm run clean && npm run build:plugin -- --sourcemap=linked --watch",
		"test": "vitest --run",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"lint": "biome lint src/",
		"format": "biome format src/ --write",
		"check": "biome check src/",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.panel.json && tsc --noEmit -p tsconfig.test.json",
		"clean": "node scripts/clean.mjs",
		"hooks": "husky",
		"release": "node scripts/release.mjs"
	},
	"keywords": [
		"signalk-node-server-plugin",
		"signalk-plugin-configurator",
		"signalk-category-nmea-2000",
		"signalk-category-ais",
		"nmea2000",
		"garmin",
		"ais"
	],
	"signalk-plugin-enabled-by-default": false,
	"signalk": {
		"appIcon": "./assets/icons/icon-192.png",
		"displayName": "NMEA 2000 Emitter Cannon",
		"screenshots": [
			"assets/screenshots/config-panel.png",
			"assets/screenshots/environment-conversions.png",
			"assets/screenshots/config-advisor.png"
		],
		"recommends": [
			"signalk-virtual-weather-sensors",
			"signalk-synthetic-values",
			"signalk-crows-nest"
		]
	},
	"author": {
		"name": "Nearl Crews",
		"email": "NearlCrews@users.noreply.github.com",
		"url": "https://github.com/NearlCrews"
	},
	"contributors": [
		{
			"name": "Nearl Crews",
			"email": "nearlcrewsx@proton.me"
		}
	],
	"license": "Apache-2.0",
	"dependencies": {
		"rxjs": "^7.8.2"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NearlCrews/signalk-nmea2000-emitter-cannon.git"
	},
	"homepage": "https://github.com/NearlCrews/signalk-nmea2000-emitter-cannon#readme",
	"bugs": {
		"url": "https://github.com/NearlCrews/signalk-nmea2000-emitter-cannon/issues"
	},
	"funding": {
		"type": "buymeacoffee",
		"url": "https://www.buymeacoffee.com/nearlcrews"
	},
	"devDependencies": {
		"@babel/core": "^8.0.1",
		"@babel/preset-react": "^8.0.1",
		"@babel/preset-typescript": "^8.0.1",
		"@biomejs/biome": "^2.5.3",
		"@canboat/canboatjs": "^3.20.0",
		"@canboat/ts-pgns": "^1.11.18",
		"@signalk/server-api": "^2.30.0",
		"@sinclair/typebox": "^0.34.52",
		"@types/express": "^5.0.6",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"babel-loader": "^10.1.1",
		"esbuild": "^0.28.1",
		"express": "^5.2.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"supertest": "^7.2.2",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10",
		"webpack": "^5.108.4",
		"webpack-cli": "^7.2.1"
	},
	"engines": {
		"node": ">=22.12"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"biome check --write"
		],
		"*.json": [
			"biome format --write --no-errors-on-unmatched"
		]
	},
	"overrides": {
		"cookie": "^0.7.0",
		"nanoid": "^3.3.8",
		"semver": "^7.6.3",
		"tmp": "^0.2.3",
		"inquirer": "^10.0.0",
		"ip-address": "^10.1.1"
	}
}
