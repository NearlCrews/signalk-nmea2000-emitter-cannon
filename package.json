{
	"name": "signalk-nmea2000-emitter-cannon",
	"version": "1.5.0",
	"description": "Signal K server plugin to convert Signal K to NMEA 2000 with Garmin PGN specification alignment and canboatjs framework compatibility",
	"main": "dist/index.js",
	"type": "module",
	"files": [
		"dist/",
		"public/",
		"assets/",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "npm run clean && npm run build:plugin && npm run build:panel",
		"build:plugin": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --external:rxjs",
		"build:panel": "webpack --config webpack.config.cjs",
		"build:watch": "npm run clean && esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --sourcemap=linked --outfile=dist/index.js --external:rxjs --watch",
		"test": "vitest --run",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"lint": "biome lint src/",
		"format": "biome format src/ --write",
		"check": "biome check src/",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.panel.json",
		"clean": "rm -rf dist && rm -f public/*.js public/*.mjs public/*.LICENSE.txt public/*.map",
		"prepare": "husky",
		"prepack": "npm run build",
		"create-release": "gh release create v$npm_package_version --generate-notes",
		"release": "git rev-parse \"v$npm_package_version\" >/dev/null 2>&1 && { echo \"tag v$npm_package_version already exists\"; exit 1; } ; git tag v$npm_package_version && git push --tags && git push && npm run create-release"
	},
	"keywords": [
		"signalk-node-server-plugin",
		"signalk-plugin-configurator",
		"signalk-category-nmea-2000",
		"signalk-category-ais",
		"nmea2000",
		"garmin",
		"marine-electronics",
		"ais",
		"navigation"
	],
	"signalk-plugin-enabled-by-default": false,
	"signalk": {
		"appIcon": "./assets/icons/icon-192.png",
		"displayName": "Signal K NMEA2000 Emitter Cannon"
	},
	"author": {
		"name": "Nearl Crews",
		"email": "NearlCrews@users.noreply.github.com",
		"url": "https://github.com/NearlCrews"
	},
	"contributors": [
		{
			"name": "Nearl Crews",
			"email": "nearlcrewsx@proton.me"
		}
	],
	"license": "Apache-2.0",
	"dependencies": {
		"@signalk/server-api": "^2.10.2",
		"@sinclair/typebox": "^0.34.49",
		"rxjs": "^7.8.2"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NearlCrews/signalk-nmea2000-emitter-cannon.git"
	},
	"homepage": "https://github.com/NearlCrews/signalk-nmea2000-emitter-cannon#readme",
	"bugs": {
		"url": "https://github.com/NearlCrews/signalk-nmea2000-emitter-cannon/issues"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@babel/preset-react": "^7.28.5",
		"@babel/preset-typescript": "^7.28.5",
		"@biomejs/biome": "^2.4.15",
		"@canboat/canboatjs": "^3.18.0",
		"@types/express": "^5.0.6",
		"@types/json-schema": "^7.0.15",
		"@types/node": "^25.0.9",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/supertest": "^7.2.0",
		"@vitest/coverage-v8": "^4.1.4",
		"@vitest/ui": "^4.0.17",
		"babel-loader": "^10.1.1",
		"esbuild": "^0.28.0",
		"express": "^5.2.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"sharp": "^0.34.5",
		"signalk-server": "^2.20.0",
		"supertest": "^7.2.2",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"vitest": "^4.0.17",
		"webpack": "^5.106.2",
		"webpack-cli": "^7.0.2"
	},
	"engines": {
		"node": ">=20.18"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"biome check --write"
		],
		"*.json": [
			"biome format --write"
		]
	},
	"overrides": {
		"cookie": "^0.7.0",
		"nanoid": "^3.3.8",
		"semver": "^7.6.3",
		"tmp": "^0.2.3",
		"inquirer": "^10.0.0",
		"ip-address": "^10.1.1"
	}
}
