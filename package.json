{
	"name": "signalk-nmea2000-emitter-cannon",
	"version": "1.10.7",
	"description": "Signal K plugin that converts Signal K deltas to Canboat-validated NMEA 2000 PGNs",
	"type": "commonjs",
	"main": "dist/index.mjs",
	"exports": "./dist/index.mjs",
	"files": [
		"dist/",
		"public/",
		"assets/",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "npm run clean && npm run build:plugin && npm run build:panel",
		"build:plugin": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --minify-syntax --minify-whitespace --outfile=dist/index.mjs --external:rxjs",
		"build:panel": "webpack --config webpack.config.cjs",
		"build:watch": "npm run clean && npm run build:plugin -- --sourcemap=linked --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:panel": "node scripts/check-panel-bundle.mjs",
		"test:panel:browser": "node scripts/check-panel-browser.mjs",
		"screenshots": "npm run build:panel && node scripts/check-panel-browser.mjs --update-screenshots",
		"check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.panel.json && tsc --noEmit -p tsconfig.test.json",
		"typecheck": "npm run check",
		"lint": "npm run lint:code && npm run lint:docs && npm run spellcheck",
		"lint:code": "biome lint . && eslint . --cache --cache-location .cache/eslint",
		"lint:docs": "markdownlint-cli2 \"*.md\" \".github/*.md\" \"docs/*.md\"",
		"lint:fix": "biome lint --write . && eslint . --fix --cache --cache-location .cache/eslint",
		"spellcheck": "cspell --no-progress --show-suggestions README.md CLAUDE.md \".github/**/*.{md,yml,yaml}\" \"docs/*.md\"",
		"ci:biome": "biome ci .",
		"ci:workflows": "node scripts/check-workflows.mjs",
		"cruise": "depcruise src --config .dependency-cruiser.cjs",
		"deadcode": "knip",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"size": "size-limit",
		"package:check": "node scripts/test-package-report.mjs && publint --pack=false --strict && node scripts/check-package.mjs",
		"pack:release": "node scripts/create-release-tarball.mjs",
		"audit": "npm run audit:runtime && npm run audit:policy && npm run audit:full",
		"audit:full": "npm audit --json | node scripts/check-audit.mjs",
		"audit:policy": "node scripts/test-audit-policy.mjs",
		"audit:runtime": "npm audit --omit=dev --audit-level=high",
		"verify:commit": "npm run ci:biome && npm run lint && npm run ci:workflows && npm run cruise && npm run deadcode",
		"verify:fast": "npm run verify:commit && npm run check",
		"verify": "npm run verify:fast && npm run test:coverage && npm run build && npm run test:panel && npm run test:panel:browser && npm run size",
		"verify:release": "npm run verify && npm run package:check && npm run audit",
		"clean": "node scripts/clean.mjs",
		"hooks": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit .githooks/pre-push",
		"release": "node scripts/release.mjs"
	},
	"keywords": [
		"signalk-node-server-plugin",
		"signalk-plugin-configurator",
		"signalk-category-nmea-2000",
		"signalk-category-ais",
		"nmea2000",
		"garmin",
		"ais"
	],
	"signalk-plugin-enabled-by-default": false,
	"signalk": {
		"appIcon": "./assets/icons/icon-192.png",
		"displayName": "NMEA 2000 Emitter Cannon",
		"screenshots": [
			"assets/screenshots/config-panel.png",
			"assets/screenshots/environment-conversions.png",
			"assets/screenshots/config-advisor.png"
		],
		"recommends": [
			"signalk-virtual-weather-sensors",
			"signalk-synthetic-values",
			"signalk-crows-nest"
		]
	},
	"author": {
		"name": "Nearl Crews",
		"email": "NearlCrews@users.noreply.github.com",
		"url": "https://github.com/NearlCrews"
	},
	"contributors": [
		{
			"name": "Nearl Crews",
			"email": "nearlcrewsx@proton.me"
		}
	],
	"license": "Apache-2.0",
	"dependencies": {
		"rxjs": "^7.8.2"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NearlCrews/signalk-nmea2000-emitter-cannon.git"
	},
	"homepage": "https://github.com/NearlCrews/signalk-nmea2000-emitter-cannon#readme",
	"bugs": {
		"url": "https://github.com/NearlCrews/signalk-nmea2000-emitter-cannon/issues"
	},
	"funding": {
		"type": "buymeacoffee",
		"url": "https://www.buymeacoffee.com/nearlcrews"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@babel/core": "^8.0.1",
		"@babel/preset-react": "^8.0.1",
		"@babel/preset-typescript": "^8.0.1",
		"@biomejs/biome": "2.5.8",
		"@canboat/canboatjs": "^3.20.0",
		"@canboat/ts-pgns": "^1.11.18",
		"@playwright/test": "1.62.1",
		"@signalk/server-api": "^2.31.0",
		"@sinclair/typebox": "^0.34.52",
		"@size-limit/file": "13.0.3",
		"@types/express": "^5.0.6",
		"@types/node": "22.20.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "4.1.10",
		"@vitest/ui": "4.1.10",
		"babel-loader": "^10.1.1",
		"cspell": "10.0.1",
		"dependency-cruiser": "^18.2.0",
		"esbuild": "^0.28.2",
		"eslint": "10.8.1",
		"express": "^5.2.1",
		"knip": "6.32.2",
		"markdownlint-cli2": "0.23.2",
		"minimizer-webpack-plugin": "5.6.1",
		"publint": "0.3.23",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"signalk-nearlcrews-ui": "0.7.1",
		"size-limit": "13.0.3",
		"supertest": "^7.2.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "8.67.0",
		"vitest": "4.1.10",
		"webpack": "^5.109.2",
		"webpack-cli": "^7.2.2"
	},
	"engines": {
		"node": ">=22.22.2"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^22.22.2 || ^24.15.0 || ^26.0.0",
			"onFail": "error"
		},
		"packageManager": {
			"name": "npm",
			"version": ">=10.9.7",
			"onFail": "error"
		}
	},
	"allowScripts": {
		"@canboat/canboatjs@3.20.0": true,
		"@serialport/bindings-cpp@11.0.3": true,
		"es5-ext": false,
		"esbuild@0.28.2": true
	},
	"packageManager": "npm@12.0.2",
	"size-limit": [
		{
			"name": "Plugin bundle",
			"path": "dist/index.mjs",
			"limit": "70 kB"
		},
		{
			"name": "Panel component chunks",
			"path": "public/[0-9]*.js",
			"limit": "48 kB"
		},
		{
			"name": "Panel federation runtime",
			"path": "public/remoteEntry.js",
			"limit": "4 kB"
		}
	]
}
