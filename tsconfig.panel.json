{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["react", "react-dom"],
		"moduleResolution": "Bundler",
		"noEmit": true
	},
	"include": [
		"src/panel/**/*",
		"src/config/**/*",
		"src/api/types.ts",
		"src/test/useConfig.test.ts"
	],
	"exclude": ["node_modules", "dist"]
}
